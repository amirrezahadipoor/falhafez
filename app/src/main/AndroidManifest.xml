<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline-first: only ads and optional update checks use the network.
         حداقلِ مجوزهای واقعاً لازم: اینترنت (تبلیغات/بروزرسانی/پرداخت)،
         وضعیتِ شبکه (پنهان‌کردنِ تبلیغاتِ آفلاین)، اعلان (یادآورِ روزانه). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- شناسه تبلیغاتی گوگل برای تپسل و شبکه‌های تبلیغاتی (الزامی برای پر شدن تبلیغ در اندروید ۱۳+) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- اندروید ۱۱ (API 30) به بعد دیدِ بسته‌ها محدود است: بدونِ این بخش،
         queryIntentActivities/getPackageInfo برای این اپ‌ها خالی برمی‌گردد و
         دکمه‌های اشتراک‌گذاری «نصب نیست» نشان می‌دادند. -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="com.whatsapp" />
        <package android:name="app.rbmain.a" />
        <package android:name="ir.nasim" />
        <package android:name="com.instagram.android" />
        <package android:name="ir.eitaa.messenger" />
        <package android:name="ir.soroush.app" />
        <!-- کافه‌بازار: پرداخت درون‌برنامه‌ای (Poolakey) و بررسی بروزرسانی -->
        <package android:name="com.farsitel.bazaar" />

        <!-- اشتراک‌گذاریِ عمومی متن/تصویر و بازکردنِ لینک در مرورگر -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- حریم خصوصی: داده (نیّت، تاریخچه، علاقه‌مندی‌ها) هرگز به فضای ابریِ گوگل منتقل نمی‌شود؛
         خروجی دستی از تنظیمات در دسترس است. -->
    <application
        android:name=".FalHafezApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FalHafez">

        <!--
            launchMode: پیش‌تر singleTask بود و باعثِ «صفحهٔ سیاه» می‌شد.
            وقتی کاربر از تنظیمات با دکمهٔ بازگشت برمی‌گشت و بعد روی آیکونِ اپ
            در لانچر می‌زد، اندروید یک intentِ MAIN/LAUNCHER تازه می‌فرستاد؛
            چون اکتیویتی زنده بود، به‌جای ساختِ دوباره فقط onNewIntent صدا زده
            می‌شد (که پیاده‌سازی نشده بود) و تسک به ریشه برمی‌گشت — در حالی که
            NavHost هنوز در مقصدِ settings مانده بود. نتیجه: صفحهٔ سیاه یا کراش.

            singleTop همان رفتارِ «یک نمونه» را می‌دهد ولی intentِ لانچر را به
            onNewIntent می‌سپارد بدونِ آنکه پشتهٔ Compose را از هم بپاشد.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FalHafez">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- تپسل: کلید اپلیکیشن برای راه‌اندازی خودکار (Auto-Init).
             فقط همین یک نام را SDK می‌خواند؛ دو متادیتای TAPSELL_APP_KEY و TAPSELL_KEY
             مربوط به SDKهای منسوخ بودند و حذف شدند. -->
        <meta-data
            android:name="TapsellMediationAppKey"
            android:value="${TapsellMediationAppKey}" />

        <!-- بیتِ امروز home-screen widget (offline). -->
        <receiver
            android:name=".presentation.widget.DailyFalWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fal_widget_info" />
        </receiver>

        <!-- Exposes cached share-images to other apps (Instagram/Telegram/WhatsApp). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
